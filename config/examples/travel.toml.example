# Travel laptop deployment example.
# Copy sections into data/config.toml on the travel machine.
#
# Suggested ChatGPT app: CAN Research - Travel

[instance]
instance_key = "travel"
display_name = "CAN Research - Travel"

[paths]
data_dir = "data"

[cansub]
host = "your-travel-cansub-usb.local"
timeout = 5.0
verify_tls = false

[tunnel]
profile = "can-research-travel"
health_host = "127.0.0.1"
health_port = 8081
install_dir = "%LOCALAPPDATA%\\CAN Research\\tunnel-client"
