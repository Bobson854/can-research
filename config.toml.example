# Example local configuration for can-research.
# Copy to data/config.toml and edit for your machine.
#
#   copy config.toml.example data\config.toml
#
# data/ is gitignored — do not commit machine-specific settings.
#
# Deployment examples for multi-instance setups:
#   config/examples/workshop.toml.example
#   config/examples/travel.toml.example

[instance]
# Stable installation identity (not derived from hostname).
# Use letters, digits, underscores, and hyphens only.
instance_key = "local"
display_name = "CAN Research (local)"

[paths]
# Root directory for SQLite database and JSONL capture storage.
# Relative paths resolve from the current working directory.
data_dir = "data"

[cansub]
# USB mDNS hostname (preferred) or direct IP address for the CANsub.2
# attached to THIS laptop. The device may change; instance identity does not.
host = "your-device-id-usb.local"
timeout = 5.0
verify_tls = false

# Optional per-channel expected CAN timing (enables capture preflight).
# Declare nominal and data bitrates for each wired channel used in research.
# When configured, live capture and observe_live_traffic refuse to start on mismatch.
#
# Office / CAN1 example (500 kbit/s nominal, 1 Mbit/s data):
#
# [cansub.channels.1]
# nominal_bitrate = 500000
# data_bitrate = 1000000
#
# Optional explicit PHY segments for `device apply-phy-timing --yes`
# (copy from `canresearch device channel-info 1` or webCAN when needed):
#
# timing = { brp = 2, seg1 = 63, seg2 = 16, sjw = 4 }
# timing_data = { brp = 4, seg1 = 15, seg2 = 4, sjw = 4 }

[connection]
# Windows tunnel connection backend for this machine.
# Current Laptop/customer OpenAI runtime: environment-backed `run` (no YAML profile).
kind = "openai-runtime-env"
mcp_url = "http://127.0.0.1:8765/mcp"
health_host = "127.0.0.1"
health_port = 8081
# Secret env var names are derived from instance_key above, e.g.:
#   instance_key = "laptop"  -> CANRESEARCH_LAPTOP_API_KEY / CANRESEARCH_LAPTOP_TUNNEL_ID
#   instance_key = "office"  -> CANRESEARCH_OFFICE_API_KEY / CANRESEARCH_OFFICE_TUNNEL_ID
# Optional explicit override for advanced/multi-project use only:
# [connection.secrets]
# api_key_env = "CANRESEARCH_CUSTOM_API_KEY"
# tunnel_id_env = "CANRESEARCH_CUSTOM_TUNNEL_ID"

[tunnel]
# Legacy profile metadata (Office/profile-based runtimes). Not used by openai-runtime-env.
# The default profile convention is can-research-<instance_key>.
profile = "can-research-local"
health_host = "127.0.0.1"
health_port = 8081
# Permanent per-user install location. Environment variables are expanded.
# setup.cmd can migrate tunnel-client.exe here from a Downloads folder.
install_dir = "%LOCALAPPDATA%\\CAN Research\\tunnel-client"
